{
  "name": "zuzu-ai-buddy",
  "version": "0.1.0",
  "private": true,
  "description": "Zuzu: a talking, seeing AI buddy demo for 6-8 year olds (Young Leaders)",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,magenta \"tsx watch server/index.ts\" \"vite\"",
    "build": "vite build",
    "start": "vite build && NODE_ENV=production tsx server/index.ts",
    "serve": "NODE_ENV=production tsx server/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "1.2.3",
    "@openai/agents": "0.22.0",
    "canvas-confetti": "^1.9.4",
    "dotenv": "^17.2.0",
    "express": "^5.3.0",
    "openai": "^7.62.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
