# Required: key for an OpenAI project with Zero Data Retention enabled
OPENAI_API_KEY=

# Set to true ONLY after OpenAI has approved and enabled Zero Data Retention for this project.
# While false, the Console shows a "Rehearsal mode" banner: do not run sessions with real children.
ZDR_CONFIRMED=false

# Model and voice
REALTIME_MODEL=gpt-realtime-2.1
REALTIME_VOICE=marin
VOICE_SPEED=1.0
REASONING_EFFORT=low
VAD_EAGERNESS=low
NOISE_REDUCTION=far_field
TRANSCRIBE_MODEL=gpt-4o-mini-transcribe

# Privacy and timing
SHARE_ROSTER_NAMES=true
ROSTER_RETENTION_HOURS=24
SESSION_WRAPUP_SECONDS=360
SESSION_MAX_SECONDS=420
SILENCE_NUDGE_SECONDS=7

# Branding
BUDDY_NAME=Zuzu
ORG_NAME=Young Leaders

# Server (keep on localhost unless you set CONSOLE_PIN)
HOST=127.0.0.1
PORT=8787
# CONSOLE_PIN=

# Frontend hosted on another origin (e.g. Vercel): comma-separated list of allowed origins.
# CORS_ORIGINS=https://your-app.vercel.app
# Set to true to also serve the built frontend (frontend/dist) from this server.
# SERVE_FRONTEND=false
